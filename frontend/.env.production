# ---------------------------------------------------------------------------
# AquaGuard AI — production frontend build
# ---------------------------------------------------------------------------
# Vite loads `.env.production` automatically for `npm run build`, so a production
# build needs no extra flags:
#
#     npm run build
#
# This file contains PROJECT-LEVEL production defaults and is safe to commit,
# because every VITE_-prefixed value is compiled into the browser bundle and is
# therefore public. There are no secrets here and there must never be.
#
# ---------------------------------------------------------------------------
# SET YOUR REAL API URL BELOW BEFORE BUILDING
# ---------------------------------------------------------------------------
# The value baked in here becomes the single hard-coded backend address in the
# shipped JavaScript. It must be:
#
#   * absolute — the built bundle is served as static files, so a relative
#     `/api` would resolve against whatever host serves the HTML, which is wrong
#     as soon as the API lives on a different origin;
#   * scheme included — https in production;
#   * without a trailing slash;
#   * listed in the backend's CORS_ORIGINS as the SITE origin (not this API URL).
# ---------------------------------------------------------------------------

VITE_API_URL=https://aquaguard-2i5c.onrender.com/api/v1

VITE_APP_NAME=AquaGuard AI
