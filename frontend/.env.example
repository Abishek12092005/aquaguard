# ---------------------------------------------------------------------------
# AquaGuard AI — frontend environment template
# Copy to `.env` and adjust. Only VITE_-prefixed vars reach the browser.
#
# `.env` is git-ignored and must NEVER be committed. Nothing in this file is a
# secret in any case: every VITE_-prefixed value is compiled into the browser
# bundle and is public by definition. That is exactly why the Aqua AI API key
# has no VITE_ variant — it lives only in the backend environment.
# ---------------------------------------------------------------------------

# Base URL of the Flask API.
#
# Development: leave as `/api`. vite.config.js proxies it to the backend, so the
# browser stays same-origin and CORS cannot mask a real failure.
#
# Production: set the absolute URL of the deployed backend, scheme included and
# no trailing slash, e.g. https://api.example.com/api. It must also be listed in
# the backend's CORS_ORIGINS.
VITE_API_URL=/api
# Legacy alias, still honoured. VITE_API_URL wins when both are set, so an
# existing configuration keeps working on upgrade.
# VITE_API_BASE_URL=/api
VITE_APP_NAME=AquaGuard AI

# --- Google Maps (OPTIONAL) ------------------------------------------------
# A BROWSER key for the Maps Raster Tiles API, created in the Google Cloud
# console and RESTRICTED BY HTTP REFERRER to the origins you serve from.
#
# It is public by definition (it ships in the bundle), so the referrer
# restriction is the protection — never put a server-side credential here.
# Leave blank to use OpenStreetMap tiles, which is the default.
VITE_GOOGLE_MAPS_API_KEY=
