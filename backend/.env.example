# ===========================================================================
# AquaGuard AI — backend environment template
# ===========================================================================
# Copy this file to `.env` and fill in real values:
#
#     Copy-Item .env.example .env        (PowerShell)
#     cp .env.example .env               (bash)
#
# `.env` is git-ignored and must NEVER be committed. It is the ONLY place
# credentials live: no password, JWT secret or API key appears anywhere in
# source code.
#
# ---------------------------------------------------------------------------
# REQUIRED IN PRODUCTION
# ---------------------------------------------------------------------------
#   DB_HOST  DB_PORT  DB_NAME  DB_USER  DB_PASSWORD
#   SECRET_KEY
#   JWT_SECRET
#   CORS_ORIGINS
#
# The backend REFUSES TO START in production if SECRET_KEY or JWT_SECRET is
# missing, still a placeholder, or shorter than 32 characters, or if
# CORS_ORIGINS is empty or contains a wildcard. That is deliberate: a deploy
# signing tokens with a published default fails silently and remotely, which is
# far worse than failing loudly at boot.
#
# Generate the two secrets with:
#     python -c "import secrets; print(secrets.token_hex(32))"
# Use a DIFFERENT value for each.
# ===========================================================================

# --- Application -----------------------------------------------------------
# production | development | testing
# Anything unrecognised resolves to production, so a typo cannot silently
# downgrade a deployment to debug behaviour.
FLASK_ENV=development
# Bind address. Behind a proxy or in a container, 0.0.0.0 lets the WSGI server
# be reached from outside; 127.0.0.1 restricts it to localhost.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# Ignored in production: ProductionConfig hard-codes DEBUG=False, so a stray
# DEBUG=true cannot expose tracebacks in a deployment.
DEBUG=true
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG
# Flask session signing. REQUIRED in production, at least 32 characters.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string

# --- MySQL -----------------------------------------------------------------
# REQUIRED in production. In development these default to a local MySQL.
#
# NOTE: on a managed provider (Aiven, PlanetScale, RDS, Railway) you normally
# set DATABASE_URL below and leave every DB_* value unset — DATABASE_URL always
# takes precedence.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aquaguard_db
DB_USER=aquaguard_ai
DB_PASSWORD=

# Optional: a full URI that overrides every DB_* value above. This is the
# preferred form for managed providers that hand you one connection string.
#
# The backend NORMALISES whatever the provider gives you into the driver + TLS
# form PyMySQL needs, so you can paste a provider string UNCHANGED:
#
#   * a bare `mysql://` scheme is rewritten to `mysql+pymysql://`;
#   * a `?ssl-mode=REQUIRED` query parameter (Aiven's default) is translated to
#     PyMySQL's `?ssl=true` and a matching `connect_args={'ssl': {}}`;
#   * `?charset=utf8mb4` is added when no charset is given.
#
# Aiven example (copy straight from the Aiven console, only the credentials and
# host change):
# DATABASE_URL=mysql://avnadmin:YOUR_PASSWORD@mysql-XXXX.aivencloud.com:22266/defaultdb?ssl-mode=REQUIRED
#
# No-TLS local example:
# DATABASE_URL=mysql+pymysql://user:password@host:3306/aquaguard_db?charset=utf8mb4
#
# If the provider's CA certificate is REQUIRED for verification (not just
# encryption), set it here and it is passed through as PyMySQL's `ssl_ca`:
# DB_SSL_CA=/etc/ssl/certs/aiven-ca.pem

# --- JWT -------------------------------------------------------------------
# REQUIRED in production. Must be DIFFERENT from SECRET_KEY. One key signs web
# sessions, the other signs API tokens, so sharing them means compromising
# either compromises both. The backend refuses to start if they are identical.
# Falls back to SECRET_KEY in DEVELOPMENT only. Generate as above.
JWT_SECRET=replace-me-with-a-different-long-random-string
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# --- Password hashing ------------------------------------------------------
# bcrypt cost. 12 is a sensible default; 4 is used automatically by the tests.
BCRYPT_LOG_ROUNDS=12

# --- CORS ------------------------------------------------------------------
# REQUIRED in production. The exact browser origins allowed to call this API,
# comma-separated, scheme included and NO trailing slash.
#
#   Development:  http://localhost:5173,http://127.0.0.1:5173
#   Production:   https://app.example.com,https://www.example.com
#
# "*" is REFUSED in production: a wildcard cannot be combined with credentialed
# requests (the browser rejects it) and would let any site call the API on a
# signed-in user's behalf.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Aqua AI ---------------------------------------------------------------
# Server-side only. React talks to Flask; Flask talks to the provider.
#
# There is deliberately no VITE_ variable for this key, because anything
# VITE_-prefixed is compiled into the browser bundle and therefore public.
#
# Optional. Left blank, the assistant reports itself as unavailable and NEVER
# fabricates a reply.
AQUA_AI_API_KEY=
AQUA_AI_MODEL=gpt-4o-mini
# Leave blank for OpenAI; set it for Azure / Groq / Together / Ollama-compatible
# endpoints.
AQUA_AI_BASE_URL=
AQUA_AI_PROVIDER=openai
AI_ENABLED=true
# How many recent turns are sent to the model. Higher costs more per request.
AI_MAX_CONTEXT_MESSAGES=20
# Keep this below the WSGI worker timeout (gunicorn.conf.py uses 90).
AI_REQUEST_TIMEOUT=30

# --- Machine learning ------------------------------------------------------
# Blank resolves to <project root>/ml/models
ML_MODEL_DIR=
ML_MODEL_FILENAME=aquaguard_random_forest.pkl
ML_PREDICTION_THRESHOLD=0.5
# The standalone 3-class pipeline (ml/train_model.py -> ml/model/ and
# ml/preprocessing/). Blank resolves to <project root>/ml. These artifacts are
# tracked in Git, so a fresh clone or deploy already has them.
ML_WATER_QUALITY_DIR=

# --- Uploads / request limits ----------------------------------------------
MAX_CONTENT_LENGTH_MB=16
# --- Production server (read by gunicorn.conf.py, ignored elsewhere) --------
# GUNICORN_WORKERS=4
# GUNICORN_BIND=0.0.0.0:5000
# GUNICORN_TIMEOUT=90
# Address of the front proxy, so X-Forwarded-* is trusted only from it.
# FORWARDED_ALLOW_IPS=127.0.0.1

# ---------------------------------------------------------------------------
# Aqua AI providers
# ---------------------------------------------------------------------------
# An ORDERED list. The assistant answers through the first provider that is
# configured and falls back to the next when one is unreachable (a missing key,
# a timeout, a rate limit). A provider that ANSWERS is not retried elsewhere.
#
# Each provider needs BOTH a key and a base URL to count as configured.
AQUA_AI_PROVIDER_ORDER=openai,gemini,meta

# OpenAI — the canonical OpenAI-compatible endpoint.
AQUA_AI_OPENAI_API_KEY=
AQUA_AI_OPENAI_MODEL=gpt-4o-mini

# Google Gemini, via its OpenAI-compatibility endpoint. A key from
# https://aistudio.google.com/apikey is enough; the base URL has a working
# default, so only the key is required here.
AQUA_AI_GEMINI_API_KEY=
AQUA_AI_GEMINI_MODEL=gemini-2.0-flash

# Meta (Llama). Meta publishes model weights rather than one hosted
# OpenAI-compatible URL, so a BASE URL IS REQUIRED — point it at whichever
# OpenAI-compatible host serves the model (Groq, Together, Fireworks, vLLM).
# Left blank, this provider is simply skipped.
AQUA_AI_META_API_KEY=
AQUA_AI_META_MODEL=llama-3.3-70b-versatile
AQUA_AI_META_BASE_URL=

# ---------------------------------------------------------------------------
# Email (SMTP)
# ---------------------------------------------------------------------------
# Used for the welcome message, the sign-in notice and the admin password
# change confirmation.
#
# MAIL_PASSWORD is a provider APP PASSWORD, not the account password. Gmail and
# most providers refuse plain password auth, and an app password is revocable on
# its own — which is what makes it acceptable in a file like this.
MAIL_ENABLED=true

# Suppressing is ON by default so a development machine or a test run never
# opens a real SMTP connection. Set to false to actually send.
MAIL_SUPPRESS_SEND=true

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=AquaGuard AI
# Defaults to MAIL_USERNAME when blank.
MAIL_DEFAULT_SENDER=
MAIL_TIMEOUT=15

# ---------------------------------------------------------------------------
# Admin console
# ---------------------------------------------------------------------------
# A SEPARATE password for the admin console, deliberately not an account
# password. It seeds the first credential; once changed through the console the
# stored hash is authoritative and this value is ignored.
#
# The console is the highest-privilege surface in the application, so it has its
# own credential that can be rotated on its own.
ADMIN_ACCESS_PASSWORD=
# The console's login name, checked WITH the password above. Defaults to
# "abishek" when unset; changeable from the console once signed in.
ADMIN_USERNAME=
# Where password-change, export and reset-code notices are sent. Defaults to
# MAIL_USERNAME.
ADMIN_NOTIFY_EMAIL=
# How long an unlocked console session stays open. Kept short on purpose.
ADMIN_SESSION_MINUTES=60
